# M‑Pay (Safaricom Daraja sandbox)
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
MPESA_SHORT_CODE=600001
MPESA_PASSKEY=your_passkey
MPESA_CALLBACK_URL=http://localhost:4000/mpesa/callback

# Africa's Talking (SMS sandbox)
AFRICAS_TALKING_API_KEY=your_api_key
AFRICAS_TALKING_USERNAME=your_username
AFRICAS_TALKING_FROM=YOUR_SENDER_ID

# Feature flags
USE_MOCK_ADAPTERS=true   # set to false when real credentials are provided

# On‑call rotation (Kenyan phone numbers)
ONCALL_ROTATION=+254712345678,+254712345679
# Seconds each person stays on‑call (default 86400 = 24h)
ONCALL_ROTATION_PERIOD=86400
# Escalation chain (phone numbers to notify if not acked)
ONCALL_ESCALATION=+254712345680,+254712345681
# Seconds before escalation (default 300 = 5 min)
ONCALL_ESCALATION_TIMEOUT=300
