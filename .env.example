# ==============================================================================
# Observatory APM Environment Configuration
# ==============================================================================

# Database Configuration (PostgreSQL 16 + TimescaleDB)
DATABASE_URL=postgres://observatory:observatory_secret@localhost:5432/observatory?sslmode=disable
DB_MAX_CONNS=50
DB_MIN_CONNS=10
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m

# Redis Configuration (Alerting state & Tail-sampling buffer)
REDIS_URL=redis://localhost:6379/0

# Ingest & API Server
PORT=8080
INGEST_API_KEY=obs_sandbox_sec_key_nairobi_2026
BATCH_FLUSH_INTERVAL_MS=500
BATCH_MAX_SIZE=1000
INGEST_QUEUE_CAPACITY=10000

# Tail-Based Sampling Settings
TAIL_SAMPLING_ENABLED=true
TAIL_DECISION_WINDOW_SEC=3
TAIL_SLOW_TRACE_THRESHOLD_MS=1500

# Regional Context & Localization
KENYA_TIMEZONE=Africa/Nairobi
CURRENCY=KES

# External Integration Feature Flags
# When true, all Safaricom Daraja & Africa's Talking calls use offline mock adapters
USE_MOCK_ADAPTERS=true

# Safaricom Daraja Sandbox (M-Pesa STK Push & Callbacks)
MPESA_CONSUMER_KEY=sandbox_daraja_consumer_key
MPESA_CONSUMER_SECRET=sandbox_daraja_consumer_secret
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
MPESA_SHORT_CODE=174379
MPESA_CALLBACK_URL=http://localhost:8080/v1/callbacks/mpesa

# Africa's Talking Sandbox (SMS Escalation Paging)
AFRICAS_TALKING_USERNAME=sandbox
AFRICAS_TALKING_API_KEY=mock_africastalking_api_key_sandbox
AFRICAS_TALKING_SENDER_ID=OBSERVATORY

# Slack Webhook Alert Channel
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/MOCK/TOKEN/CHANNEL

# On-Call Schedule Rotation (Kenyan E.164 phone numbers)
ONCALL_ROTATION=+254711000001,+254711000002,+254711000003
ONCALL_ROTATION_PERIOD=86400
ONCALL_ESCALATION=+254711000099,+254711000098
ONCALL_ESCALATION_TIMEOUT=300

# Web Dashboard (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8080

# Demo Simulation App
DEMO_PORT=4000
OBSERVATORY_ENDPOINT=http://localhost:8080
